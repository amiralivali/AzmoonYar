{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SeriLog": {
    "Using" : ["SeriLog.Sinks.File","SeriLog.Sinks.Console","SeriLog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo":[
      {"Name": "Console"},
      {
        "Name" : "File",
        "Args": {
          "path": "logs/azmoonyar-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit" : "14"
        }
      },
      { 
        "Name" : "Seq",
        "Args": {
          "serverUrl": "http://localhost:5241" 
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*"
}
